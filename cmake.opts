# Compiler selection
SPECIFIC_COMPILER=""

# Visual Studio generator
SPECIFIC_GENERATOR="-G \"Visual Studio 17 2022\""

# Optional external libraries
OPM_FLAGS=""

# Header check target
DUMUX_ENABLE_HEADERCHECK=OFF

# MSVC compiler flags
MSVC_RELEASE_FLAGS="/O2 /DNDEBUG /W3"
MSVC_DEBUG_FLAGS="/Od /Zi /W3"
MSVC_RELWITHDEBINFO_FLAGS="/O2 /Zi /W3"

# CMake flags
CMAKE_FLAGS="$SPECIFIC_COMPILER $SPECIFIC_GENERATOR $OPM_FLAGS
-DCMAKE_TOOLCHAIN_FILE=C:/Users/m.giraud/Documents/CPlantBox-windows/vcpkg/scripts/buildsystems/vcpkg.cmake
-DVCPKG_TARGET_TRIPLET=x64-windows-static-md
-DBUILD_SHARED_LIBS=OFF
-DCMAKE_CXX_FLAGS_RELEASE=\"$MSVC_RELEASE_FLAGS\"
-DCMAKE_CXX_FLAGS_DEBUG=\"$MSVC_DEBUG_FLAGS\"
-DCMAKE_CXX_FLAGS_RELWITHDEBINFO=\"$MSVC_RELWITHDEBINFO_FLAGS\"
-DCMAKE_BUILD_TYPE=RelWithDebInfo
-DENABLE_HEADERCHECK=$DUMUX_ENABLE_HEADERCHECK
-DDUNE_GRID_EXPERIMENTAL_GRID_EXTENSIONS=TRUE
# Force compiler and build tools to use symlink without spaces
-DCMAKE_CXX_COMPILER=C:/VS2022/VC/Tools/MSVC/14.44.35207/bin/Hostx64/x64/cl.exe
-DCMAKE_C_COMPILER=C:/VS2022/VC/Tools/MSVC/14.44.35207/bin/Hostx64/x64/cl.exe
-DCMAKE_MAKE_PROGRAM=C:/VS2022/MSBuild/Current/Bin/amd64/MSBuild.exe
"

#-DCMAKE_CXX_FLAGS_RELEASE='$MSVC_RELEASE_FLAGS'