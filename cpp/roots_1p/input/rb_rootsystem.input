[Problem]
Name = rb_rootsystem 
verbose = 0

[TimeLoop]
TEnd =  864000 #
MaxTimeStepSize = 8640
DtInitial = 1 # [s]
CheckTimes = 86400 172800 259200 345600 432000 518400 604800 691200 777600

[RootSystem.Grid]
File = ../../../cpp/roots_1p/Anagallis_femina_Leitner_2010.xml  # Triticum_aestivum_a_Bingham_2011  # Anagallis_femina_Leitner_2010
InitialT = 2 # days
Grow = False
Confined = 20 20 50 

[RootSystem.Conductivity]
Kr = 1.728 # radial conductivity [cm/hPa/day] 
Kx = 432 # axial conductivity [cm^4/hPa/day]

[RootSystem.Collar]
Transpiration =  6
Sinusoidal = True

[Soil.IC]
P = -500 # cm pressure head

[Vtk]
AddProcessRank = "false"
AddVelocity = "true"