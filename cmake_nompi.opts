# === Compiler settings ===
SPECIFIC_COMPILER="
-DCMAKE_C_COMPILER=C:/msys64/mingw64/bin/gcc.exe
-DCMAKE_CXX_COMPILER=C:/msys64/mingw64/bin/g++.exe
"

# === Generator ===
SPECIFIC_GENERATOR="
-DCMAKE_GENERATOR=Ninja 
-DCMAKE_MAKE_PROGRAM=C:/msys64/mingw64/bin/ninja.exe
"

# === OPMS flags ===
OPM_FLAGS=""

# Enable or disable headercheck
DUMUX_ENABLE_HEADERCHECK=OFF

# Thread flags for MSYS/MinGW
STDTHREAD_LINK_FLAGS="-pthread"

# === C++ flags for MinGW ===
MIN_GW_RELEASE_FLAGS="-O2 -DNDEBUG -include C:/Users/m.giraud/Documents/CPlantBox-windows/posix_compat.h -mstatic-libgcc -mstatic-libstdc++ -static-libgomp -pthread"
MIN_GW_DEBUG_FLAGS="-O0 -include C:/Users/m.giraud/Documents/CPlantBox-windows/posix_compat.h -mstatic-libgcc -mstatic-libstdc++ -static-libgomp -pthread"
MIN_GW_RELWITHDEBINFO_FLAGS="-O2 -include C:/Users/m.giraud/Documents/CPlantBox-windows/posix_compat.h -mstatic-libgcc -mstatic-libstdc++ -static-libgomp -pthread"

# === Main CMake flags ===
CMAKE_FLAGS="$SPECIFIC_COMPILER $SPECIFIC_GENERATOR $OPM_FLAGS
-DCMAKE_CXX_FLAGS_RELEASE=\"${MIN_GW_RELEASE_FLAGS}\"
-DCMAKE_CXX_FLAGS_DEBUG=\"${MIN_GW_DEBUG_FLAGS}\"
-DCMAKE_CXX_FLAGS_RELWITHDEBINFO=\"${MIN_GW_RELWITHDEBINFO_FLAGS}\"
-DBUILD_SHARED_LIBS=OFF
-DCMAKE_BUILD_TYPE=Release
-DENABLE_HEADERCHECK=$DUMUX_ENABLE_HEADERCHECK
-DDUNE_GRID_EXPERIMENTAL_GRID_EXTENSIONS:BOOL=TRUE
-DCMAKE_DISABLE_FIND_PACKAGE_MPI=1
-DUG_ENABLE_PARALLEL=0
-DDUNE_PYTHON_ALLOW_GET_PIP=1
-DCMAKE_CXX_STANDARD=17
-DCXX_MAX_STANDARD=17
-DCMAKE_CXX_STANDARD_REQUIRED=ON
-DCXX_MAX_SUPPORTED_STANDARD=17
-Ddune-common_DIR=C:/Users/m.giraud/Documents/CPlantBox-windows/dune-common/build-cmake
-Ddune-geometry_DIR=C:/Users/m.giraud/Documents/CPlantBox-windows/dune-geometry/build-cmake
-Ddune-istl_DIR=C:/Users/m.giraud/Documents/CPlantBox-windows/dune-istl/build-cmake
